<script>

const token = localStorage.getItem("token");

if(!token){
  window.location.href = "/login";
}

</script>


<%- include('../partials/nav') %>

<h1><%= entrega.descricao %></h1>

<%- include('../partials/flash') %>

<p><strong>Origem:</strong> <%= entrega.origem %></p>
<p><strong>Destino:</strong> <%= entrega.destino %></p>
<p><strong>Status:</strong> <%= entrega.status %></p>

<hr>

<h2>Histórico</h2>

<ul>
  <% historico.forEach(e => { %>
    <li>
      <%= new Date(e.data).toLocaleString() %> - 
      <%= e.descricao %>
    </li>
  <% }) %>
</ul>

<hr>

<h2>Ações</h2>

<form action="/painel/entregas/<%= entrega.id %>?_method=PATCH" method="POST">
  <button type="submit">Avançar Status</button>
</form>

<button
  data-id="<%= entrega.id %>"
  onclick="cancelarEntrega(this.dataset.id)"
>
  Cancelar
</button>

<script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>

<script>

async function cancelarEntrega(id){

  try{

    const token = localStorage.getItem("token");

    await axios.patch(
      `/api/entregas/${id}/cancelar`,
      {},
      {
        headers:{
          Authorization: `Bearer ${token}`
        }
      }
    );

    alert("Entrega cancelada!");

    location.reload();

  }catch(err){

    alert(
      err.response?.data?.erro || "Erro ao cancelar"
    );
  }
}

</script>